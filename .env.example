# ========================================
# Anthropic API
# ========================================
ANTHROPIC_API_KEY=sk-ant-...

# ========================================
# システム API キー（家族共有）
# 生成: openssl rand -hex 32
# ========================================
KITCHEN_API_KEY=REPLACE_WITH_RANDOM_32CHAR_HEX

# ========================================
# LangSmith オブザーバビリティ（任意）
# ========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...

# ========================================
# NAS マウントポイント（ホスト側パス）
# WSL2: /home/yourname/nas/kitchen など
# ========================================
NAS_MOUNT_PATH=./nas-mount

# ========================================
# ローカル開発用（Docker不使用時）
# ========================================
DB_PATH=./data/app.db
PROMPTS_DIR=./backend/prompts
NAS_IMAGES_PATH=./nas-mount/recipe_images
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=["http://localhost:5173","https://kitchen.local"]
